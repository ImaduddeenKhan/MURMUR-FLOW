# Murmur Flow environment configuration
# Keys can also be pasted in the Settings screen after the app is running.

PORT=3050

# Groq API Key. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API Key. Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Default Engine Selection
# Options: 'groq' | 'gemini' | 'hybrid'
DEFAULT_STT_PROVIDER=groq
DEFAULT_LLM_PROVIDER=groq

# Zero-Edit Defaults
DEFAULT_TONE=casual
AUTO_COPY_CLIPBOARD=true
